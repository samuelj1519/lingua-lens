              "type": "string"
            },
            "scope": "application",
            "order": 25,
            "tags": [
              "advanced"
            ],
            "markdownDescription": "%config.llm.extraHeaders.markdownDescription%"
          },
          "aiTranslate.llm.jsonMode": {
