{
  "name": "cursor-ai-translate",
  "displayName": "AI Translate",
  "description": "Translate comments, strings, and documents in your editor with an OpenAI-compatible LLM",
  "version": "0.6.0",
  "publisher": "cursor-ai-translate",
  "repository": {
    "type": "git",
    "url": "https://github.com/local/cursor-ai-translate"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Glossary path is not read in restricted untrusted workspaces",
      "restrictedConfigurations": [
        "aiTranslate.glossary.path",
        "aiTranslate.detection.skipPatterns"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Hover and selection translation only in virtual workspaces"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "aiTranslate.toggle",
        "title": "%command.toggle%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.selectTargetLanguage",
        "title": "%command.selectTargetLanguage%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.setApiKey",
        "title": "%command.setApiKey%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.clearApiKey",
        "title": "%command.clearApiKey%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.testConnection",
        "title": "%command.testConnection%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.translateSelection",
        "title": "%command.translateSelection%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.translateDocument",
        "title": "%command.translateDocument%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.refreshPreview",
        "title": "%command.refreshPreview%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.refreshDocumentTranslation",
        "title": "%command.refreshDocumentTranslation%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.hover.refresh",
        "title": "%command.hoverRefresh%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.showQuickPick",
        "title": "%command.showQuickPick%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.translateSelectionPopup",
        "title": "%command.translateSelectionPopup%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.selection.replace",
        "title": "%command.selectionReplace%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.selection.insertBelow",
        "title": "%command.selectionInsertBelow%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.generateSideFile",
        "title": "%command.generateSideFile%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.clearCache",
        "title": "%command.clearCache%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.disableForWorkspace",
        "title": "%command.disableForWorkspace%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.enableForWorkspace",
        "title": "%command.enableForWorkspace%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.openGlossary",
        "title": "%command.openGlossary%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.showLog",
        "title": "%command.showLog%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.openSettings",
        "title": "%command.openSettings%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.openSettingsPanel",
        "title": "%command.openSettingsPanel%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.acknowledgePrivacy",
        "title": "%command.acknowledgePrivacy%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.hover.copy",
        "title": "%command.hoverCopy%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.hover.insertComment",
        "title": "%command.hoverInsertComment%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.hover.retranslate",
        "title": "%command.hoverRetranslate%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.translateClipboardOrSelection",
        "title": "%command.translateClipboardOrSelection%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.translateReplaceSelection",
        "title": "%command.translateReplaceSelection%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.translateInsertBelow",
        "title": "%command.translateInsertBelow%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.translateGitCommitAtLine",
        "title": "%command.translateGitCommitAtLine%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.translateScmInput",
        "title": "%command.translateScmInput%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.generateLocaleFile",
        "title": "%command.generateLocaleFile%",
        "category": "AI Translate"
      },
      {
        "command": "aiTranslate.suggestVariableNames",
        "title": "%command.suggestVariableNames%",
        "category": "AI Translate"
      }
    ],
    "keybindings": [
      {
        "command": "aiTranslate.translateSelection",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "aiTranslate.translateClipboardOrSelection",
        "key": "ctrl+alt+shift+y",
        "mac": "cmd+alt+shift+y"
      },
      {
        "command": "aiTranslate.translateReplaceSelection",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "aiTranslate.translateInsertBelow",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+alt+shift+b",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "aiTranslate.translateDocument",
        "key": "ctrl+alt+shift+d",
        "mac": "cmd+alt+shift+d",
        "when": "editorTextFocus && resourceLangId =~ /(markdown|plaintext)/"
      },
      {
        "command": "aiTranslate.translateSelectionPopup",
        "key": "ctrl+alt+shift+p",
        "mac": "cmd+alt+shift+p",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aiTranslate.acknowledgePrivacy",
          "when": "false"
        },
        {
          "command": "aiTranslate.hover.copy",
          "when": "false"
        },
        {
          "command": "aiTranslate.hover.insertComment",
          "when": "false"
        },
        {
          "command": "aiTranslate.hover.retranslate",
          "when": "false"
        },
        {
          "command": "aiTranslate.hover.refresh",
          "when": "false"
        },
        {
          "command": "aiTranslate.refreshPreview",
          "when": "resourceScheme == aitranslate"
        },
        {
          "command": "aiTranslate.translateSelection",
          "when": "editorHasSelection"
        }
      ],
      "editor/context": [
        {
          "command": "aiTranslate.translateSelection",
          "when": "editorHasSelection",
          "group": "navigation@90"
        },
        {
          "command": "aiTranslate.translateDocument",
          "when": "resourceScheme != aitranslate && (resourceLangId == markdown || resourceLangId == plaintext)",
          "group": "navigation@89"
        },
        {
          "command": "aiTranslate.generateSideFile",
          "when": "resourceScheme != aitranslate && (resourceLangId == markdown || resourceLangId == plaintext)",
          "group": "navigation@88"
        }
      ],
      "editor/title": [
        {
          "command": "aiTranslate.translateDocument",
          "when": "resourceScheme != aitranslate && (resourceLangId == markdown || resourceLangId == plaintext)",
          "group": "navigation@1",
          "icon": "$(globe)"
        },
        {
          "command": "aiTranslate.refreshPreview",
          "when": "resourceScheme == aitranslate",
          "group": "navigation@1",
          "icon": "$(refresh)"
        },
        {
          "command": "aiTranslate.generateSideFile",
          "when": "resourceScheme != aitranslate && (resourceLangId == markdown || resourceLangId == plaintext)",
          "group": "1_aiTranslate"
        }
      ],
      "explorer/context": [
        {
          "command": "aiTranslate.translateDocument",
          "when": "resourceExtname =~ /\\.(md|markdown|txt)$/",
          "group": "7_aiTranslate"
        },
        {
          "command": "aiTranslate.generateSideFile",
          "when": "resourceExtname =~ /\\.(md|markdown|txt)$/",
          "group": "7_aiTranslate"
        }
      ]
    },
    "configuration": [
      {
        "title": "%config.section.general.title%",
        "order": 1,
        "properties": {
          "aiTranslate.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "order": 1,
            "markdownDescription": "%config.enabled.markdownDescription%"
          },
          "aiTranslate.targetLanguage": {
            "type": "string",
            "default": "zh-CN",
            "enum": [
              "zh-CN",
              "zh-TW",
              "en",
              "ja",
              "ko",
              "fr",
              "de",
              "es",
              "ru"
            ],
            "enumDescriptions": [
              "%config.targetLanguage.enum.zh-CN%",
              "%config.targetLanguage.enum.zh-TW%",
              "%config.targetLanguage.enum.en%",
              "%config.targetLanguage.enum.ja%",
              "%config.targetLanguage.enum.ko%",
              "%config.targetLanguage.enum.fr%",
              "%config.targetLanguage.enum.de%",
              "%config.targetLanguage.enum.es%",
              "%config.targetLanguage.enum.ru%"
            ],
            "scope": "resource",
            "order": 2,
            "markdownDescription": "%config.targetLanguage.markdownDescription%"
          },
          "aiTranslate.detection.strictChineseVariant": {
            "type": "boolean",
            "default": false,
            "scope": "resource",
            "order": 3,
            "markdownDescription": "%config.detection.strictChineseVariant.markdownDescription%"
          },
          "aiTranslate.detection.minLength": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "maximum": 64,
            "scope": "resource",
            "order": 10,
            "tags": [
              "advanced"
            ],
            "markdownDescription": "%config.detection.minLength.markdownDescription%"
          },
          "aiTranslate.detection.targetRatio": {
            "type": "number",
            "default": 0.6,
            "minimum": 0,
            "maximum": 1,
            "scope": "resource",
            "order": 11,
            "tags": [
              "advanced"
            ],
            "markdownDescription": "%config.detection.targetRatio.markdownDescription%"
          },
          "aiTranslate.detection.reliableMinLength": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 500,
            "scope": "resource",
            "order": 12,
            "tags": [
              "advanced"
            ],
            "markdownDescription": "%config.detection.reliableMinLength.markdownDescription%"
          },
          "aiTranslate.detection.skipPatterns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "scope": "resource",
            "order": 13,
            "tags": [
              "advanced"
            ],
            "markdownDescription": "%config.detection.skipPatterns.markdownDescription%"
          },
          "aiTranslate.selection.output": {
            "type": "string",
            "enum": [
              "auto",
              "notification",
              "document"
            ],
            "enumDescriptions": [
              "%config.selection.output.enum.auto%",
              "%config.selection.output.enum.notification%",
              "%config.selection.output.enum.document%"
            ],
            "default": "auto",
            "scope": "resource",
            "order": 20,
            "markdownDescription": "%config.selection.output.markdownDescription%"
          },
          "aiTranslate.privacy.exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "**/.env",
              "**/.env.*",
              "**/*.pem",
              "**/*.key",
              "**/*.p12",
              "**/id_rsa*",
              "**/secrets/**",
              "**/.git/**",
              "**/node_modules/**"
            ],
            "scope": "resource",
            "order": 30,
            "markdownDescription": "%config.privacy.exclude.markdownDescription%"
          },
          "aiTranslate.statusBar.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "order": 40,
            "markdownDescription": "%config.statusBar.enabled.markdownDescription%"
          }
        }
      },
      {
        "title": "%config.section.llm.title%",
        "order": 2,
        "properties": {
          "aiTranslate.llm.baseUrl": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "scope": "application",
            "format": "uri",
            "order": 1,
            "markdownDescription": "%config.llm.baseUrl.markdownDescription%"
          },
          "aiTranslate.llm.model": {
            "type": "string",
            "default": "",
            "scope": "application",
            "order": 2,
            "markdownDescription": "%config.llm.model.markdownDescription%"
          },
          "aiTranslate.llm.stream": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "order": 3,
            "markdownDescription": "%config.llm.stream.markdownDescription%"
          },
          "aiTranslate.llm.extraBody": {
            "type": "object",
            "default": {},
            "scope": "application",
            "order": 4,
            "markdownDescription": "%config.llm.extraBody.markdownDescription%"
          },
          "aiTranslate.llm.systemPrompt": {
            "type": "string",
            "default": "",
