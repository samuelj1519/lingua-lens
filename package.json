        "order": 7,
        "properties": {
          "aiTranslate.privacy.blockSecrets": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "order": 1,
            "markdownDescription": "%config.privacy.blockSecrets.markdownDescription%"
          },
          "aiTranslate.privacy.allowedSchemes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "file",
              "untitled",
              "vscode-remote",
              "vscode-notebook-cell"
            ],
            "scope": "application",
            "order": 2,
            "tags": [
              "advanced"
            ],
            "markdownDescription": "%config.privacy.allowedSchemes.markdownDescription%"
          },
          "aiTranslate.parser.maxFileSizeKB": {
            "type": "number",
            "default": 1024,
            "minimum": 16,
            "maximum": 65536,
            "scope": "application",
            "order": 10,
            "tags": [
              "advanced"
            ],
            "markdownDescription": "%config.parser.maxFileSizeKB.markdownDescription%"
          },
          "aiTranslate.log.level": {
            "type": "string",
            "enum": [
              "trace",
              "debug",
              "info",
              "warn",
              "error",
              "off"
            ],
            "enumDescriptions": [
              "%config.log.level.enum.trace%",
              "%config.log.level.enum.debug%",
              "%config.log.level.enum.info%",
              "%config.log.level.enum.warn%",
              "%config.log.level.enum.error%",
              "%config.log.level.enum.off%"
            ],
            "default": "info",
            "scope": "application",
            "order": 20,
            "tags": [
              "advanced"
            ],
            "markdownDescription": "%config.log.level.markdownDescription%"
          }
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".translate-glossary.json",
        "url": "./schemas/translate-glossary.schema.json"
      }
    ]
  },
  "scripts": {
    "merge-config": "node scripts/merge-configuration.mjs",
    "merge-nls": "node scripts/merge-nls.mjs",
    "prebuild": "npm run merge-config && npm run merge-nls",
    "generate-docs": "node scripts/generate-settings-reference.mjs && node scripts/generate-commands-reference.mjs",
    "pretest": "npm run merge-config && npm run merge-nls && npm run generate-docs",
    "build": "node esbuild.mjs && node scripts/copy-wasm.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies",
    "smoke:tree-sitter": "node scripts/smoke-tree-sitter.mjs",
    "test:integration": "npm run build && node scripts/run-integration.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.6",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^2.26.0",
    "esbuild": "^0.21.5",
    "opencc-js": "^1.4.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "picomatch": "^4.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "tinyld": "^1.3.4",
    "tree-sitter-wasms": "^0.1.12",
    "unified": "^11.0.5",
    "web-tree-sitter": "^0.22.6"
  }
}
